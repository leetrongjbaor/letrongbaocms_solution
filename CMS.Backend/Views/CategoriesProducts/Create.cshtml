@model CMS.Data.Entities.CategoryProduct
@{
    ViewData["Title"] = "Thêm Danh Mục Sản Phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="text-success fw-bold mb-4">➕ THÊM DANH MỤC SẢN PHẨM</h2>
            <hr />
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control"
                           placeholder="Nhập tên danh mục..." />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Nhập mô tả danh mục..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ảnh đại diện:</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Hoặc link ảnh:</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://... hoặc /uploads/categories/..." />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        💾 Lưu danh mục
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </div>
</div>
