@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{
    ViewData["Title"] = "Danh Mục Sản Phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">📦 DANH MỤC SẢN PHẨM</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary fs-6">Tổng: @Model.Count() danh mục</span>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm danh mục
            </a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Tên Danh Mục</th>
                <th>Mô Tả</th>
                <th style="width:160px" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Xóa danh mục @item.Name?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>