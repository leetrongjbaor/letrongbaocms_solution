<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS.Backend</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" />

    <style>
        body {
            background: #f5f7fb;
        }

        /* ===== SIDEBAR ===== */
        #sidebar {
            width: 240px;
            min-height: 100vh;
            background: #1e293b;
            color: #cbd5e1;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            transition: width .25s;
        }

        .sidebar-brand {
            padding: 20px 20px 16px;
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            border-bottom: 1px solid #334155;
            text-decoration: none;
            display: block;
        }

            .sidebar-brand span {
                color: #38bdf8;
            }

        .sidebar-section {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #64748b;
            padding: 16px 20px 6px;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-nav li a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 20px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 14px;
                border-left: 3px solid transparent;
                transition: all .15s;
            }

                .sidebar-nav li a:hover,
                .sidebar-nav li a.active {
                    background: #334155;
                    color: #fff;
                    border-left-color: #38bdf8;
                }

                .sidebar-nav li a i {
                    font-size: 16px;
                    width: 20px;
                }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 20px;
            font-size: 12px;
            color: #475569;
            border-top: 1px solid #334155;
        }

        /* ===== MAIN CONTENT ===== */
        #main-content {
            margin-left: 240px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== TOPBAR ===== */
        #topbar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
        }

            #topbar .page-title {
                font-size: 15px;
                font-weight: 600;
                color: #1e293b;
                margin: 0;
            }

            #topbar .user-info {
                font-size: 13px;
                color: #64748b;
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .avatar {
            width: 32px;
            height: 32px;
            background: #38bdf8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
        }

        /* ===== PAGE BODY ===== */
        .page-body {
            padding: 24px;
            flex: 1;
        }

        footer {
            margin-left: 0;
            background: #fff;
            border-top: 1px solid #e2e8f0;
            padding: 12px 24px;
            font-size: 12px;
            color: #94a3b8;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            #sidebar {
                width: 0;
                overflow: hidden;
            }

            #main-content {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>

    @* ===== SIDEBAR ===== *@
    <div id="sidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-grid-3x3-gap-fill me-2"></i>CMS<span>.Admin</span>
        </a>

        <div class="sidebar-section">Menu chính</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Dashboard
                </a>
            </li>
        </ul>

        <div class="sidebar-section">CMS</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Category" asp-action="Index">
                    <i class="bi bi-folder"></i> Danh mục
                </a>
            </li>
            <li>
                <a asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i> Bài viết
                </a>
            </li>
            <li>
                <a asp-controller="User" asp-action="Index">
                    <i class="bi bi-person"></i> Thành viên
                </a>
            </li>
        </ul>

        <div class="sidebar-section">Cửa hàng</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="CategoriesProducts" asp-action="Index">
                    <i class="bi bi-tag"></i> Danh mục SP
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="Index">
                    <i class="bi bi-bag"></i> Sản phẩm
                </a>
            </li>
            <li>
                <a asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-people"></i> Khách hàng
                </a>
            </li>
            <li>
                <a asp-controller="Order" asp-action="Index">
                    <i class="bi bi-receipt"></i> Đơn hàng
                </a>
            </li>
            <li>
                <a asp-controller="OrderDetail" asp-action="Index">
                    <i class="bi bi-list-check"></i> Chi tiết đơn
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <i class="bi bi-person-circle me-1"></i>
            Lê Trọng Bảo &nbsp;·&nbsp; 2123110056
        </div>
    </div>

    @* ===== MAIN CONTENT ===== *@
    <div id="main-content">

        @* TOPBAR *@
        <div id="topbar">
            <p class="page-title">
                <i class="bi bi-chevron-right me-1 text-muted"></i>
                @ViewData["Title"]
            </p>
            <div class="user-info">
                <span>Lê Trọng Bảo</span>
                <div class="avatar">B</div>
            </div>
        </div>

        @* PAGE BODY *@
        <div class="page-body">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        @* FOOTER *@
        <footer>
            &copy; 2026 - CMS.Backend &nbsp;·&nbsp;
            <a asp-controller="Home" asp-action="Privacy" class="text-muted">Privacy</a>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Active link highlight *@
    <script>
        const links = document.querySelectorAll('.sidebar-nav a');
        links.forEach(link => {
            if (link.href === window.location.href) {
                link.classList.add('active');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>