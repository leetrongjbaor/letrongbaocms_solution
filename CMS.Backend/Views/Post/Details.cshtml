@model CMS.Data.Entities.Post

<div class="container mt-4">
    <div class="card shadow-sm">
        <img src="@Model.ImageUrl" class="card-img-top" style="max-height:300px; object-fit:cover;">
        <div class="card-body">
            <span class="badge bg-info text-dark mb-2">@Model.Category.Name</span>
            <h2 class="card-title text-primary">@Model.Title</h2>
            <p class="text-muted small">
                Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
            </p>
            <hr>
            <p class="card-text">@Model.Content</p>
            <a asp-controller="Post" asp-action="Index" class="btn btn-secondary">← Quay lại</a>
        </div>
    </div>
</div>