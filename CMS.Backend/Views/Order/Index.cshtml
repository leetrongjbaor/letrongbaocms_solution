@model IEnumerable<CMS.Data.Entities.Order>
@{
    ViewData["Title"] = "Danh Sách Đơn Hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold">🧾 DANH SÁCH ĐƠN HÀNG</h2>
        <span class="badge bg-secondary fs-6">Tổng: @Model.Count() đơn hàng</span>
    </div>
    <table class="table table-bordered table-hover table-striped">
        <thead class="table-danger">
            <tr>
                <th>ID Đơn</th>
                <th>Khách Hàng</th>
                <th>Ngày Đặt</th>
                <th>Trạng Thái</th>
                <th>Ghi Chú</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.Id</td>
                    <td>@(item.Customer?.FullName ?? "N/A")</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @* Status là int: 0=Chờ duyệt, 1=Đang giao, 2=Đã xong *@
                        @{
                            var (badgeClass, statusText) = item.Status switch
                            {
                                0 => ("bg-warning text-dark", "Chờ duyệt"),
                                1 => ("bg-primary", "Đang giao"),
                                2 => ("bg-success", "Đã xong"),
                                _ => ("bg-secondary", "Không xác định")
                            };
                        }
                        <span class="badge @badgeClass">@statusText</span>
                    </td>
                    <td>@(item.Notes ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
