@model IEnumerable<CMS.Data.Entities.Order>
@{
    ViewData["Title"] = "Lịch Sử Mua Hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger mb-1">Lịch sử mua hàng</h2>
            <div class="text-muted">Quản lý đơn hàng, trạng thái và tổng giá trị mua hàng.</div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-dark fs-6">Tổng: @Model.Count() đơn</span>
            <a asp-action="Create" class="btn btn-danger btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm đơn
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Tổng doanh thu</div>
                    <div class="fs-4 fw-bold text-danger">
                        @Model.Sum(o => o.OrderDetails?.Sum(d => d.Quantity * d.UnitPrice) ?? 0).ToString("N0") VNĐ
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Sản phẩm đã đặt</div>
                    <div class="fs-4 fw-bold">
                        @Model.Sum(o => o.OrderDetails?.Sum(d => d.Quantity) ?? 0)
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Đơn chờ duyệt</div>
                    <div class="fs-4 fw-bold text-warning">
                        @Model.Count(o => o.Status == 0)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th class="text-center">Số món</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th class="text-center" style="width:220px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var totalItems = item.OrderDetails?.Sum(d => d.Quantity) ?? 0;
                        var totalAmount = item.OrderDetails?.Sum(d => d.Quantity * d.UnitPrice) ?? 0;
                        var (badgeClass, statusText) = item.Status switch
                        {
                            0 => ("bg-warning text-dark", "Chờ duyệt"),
                            1 => ("bg-primary", "Đang giao"),
                            2 => ("bg-success", "Đã xong"),
                            _ => ("bg-secondary", "Không xác định")
                        };

                        <tr>
                            <td class="fw-bold">#@item.Id</td>
                            <td>
                                <div class="fw-semibold">@(item.Customer?.FullName ?? "N/A")</div>
                                <small class="text-muted">@(item.Customer?.Phone ?? "")</small>
                            </td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@totalItems</span>
                            </td>
                            <td class="text-end fw-bold text-danger">@totalAmount.ToString("N0") VNĐ</td>
                            <td><span class="badge @badgeClass">@statusText</span></td>
                            <td class="text-muted">@(item.Notes ?? "—")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">
                                    Giỏ hàng
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                    Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Xóa đơn hàng #@item.Id?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
