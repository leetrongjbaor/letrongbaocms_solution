@model CMS.Data.Entities.Order
@{
    ViewData["Title"] = "Thêm Đơn Hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="text-success fw-bold mb-4">➕ THÊM ĐƠN HÀNG MỚI</h2>
            <hr />
            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label fw-bold">Khách hàng:</label>
                    <select asp-for="CustomerId" class="form-select">
                        <option value="">-- Chọn khách hàng --</option>
                        @foreach (var c in ViewBag.Customers)
                        {
                            <option value="@c.Id">@c.FullName (@c.Phone)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Trạng thái:</label>
                    <select asp-for="Status" class="form-select">
                        <option value="0">⏳ Chờ duyệt</option>
                        <option value="1">🚚 Đang giao</option>
                        <option value="2">✅ Đã xong</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Ghi chú:</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Nhập ghi chú đơn hàng..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        💾 Lưu đơn hàng
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </div>
</div>