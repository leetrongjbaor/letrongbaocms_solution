@model CMS.Data.Entities.Order
@{
    ViewData["Title"] = $"Giỏ Hàng Đơn #{Model.Id}";
    var details = Model.OrderDetails ?? new List<CMS.Data.Entities.OrderDetail>();
    var totalItems = details.Sum(d => d.Quantity);
    var totalAmount = details.Sum(d => d.Quantity * d.UnitPrice);
    var (badgeClass, statusText) = Model.Status switch
    {
        0 => ("bg-warning text-dark", "Chờ duyệt"),
        1 => ("bg-primary", "Đang giao"),
        2 => ("bg-success", "Đã xong"),
        _ => ("bg-secondary", "Không xác định")
    };
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger mb-1">Giỏ hàng của đơn #@Model.Id</h2>
            <div class="text-muted">
                @(Model.Customer?.FullName ?? "N/A") · @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="OrderDetail" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-danger btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm sản phẩm
            </a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Trạng thái</div>
                    <span class="badge @badgeClass mt-2">@statusText</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Số lượng sản phẩm</div>
                    <div class="fs-4 fw-bold">@totalItems</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Tổng tiền</div>
                    <div class="fs-4 fw-bold text-danger">@totalAmount.ToString("N0") VNĐ</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">
            Sản phẩm trong giỏ hàng
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-center" style="width:150px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!details.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                Đơn này chưa có sản phẩm nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in details)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name"
                                                 class="rounded border"
                                                 style="width:64px;height:64px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded border bg-light d-flex align-items-center justify-content-center"
                                                 style="width:64px;height:64px;">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold">@(item.Product?.Name ?? "N/A")</div>
                                            <small class="text-muted">Mã SP: #@item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center fw-bold">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0") VNĐ</td>
                                <td class="text-end fw-bold text-danger">
                                    @((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ
                                </td>
                                <td class="text-center">
                                    <a asp-controller="OrderDetail" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning">Sửa</a>
                                    <a asp-controller="OrderDetail" asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Xóa sản phẩm này khỏi đơn #@Model.Id?')">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-dark">
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Tổng cộng</td>
                        <td class="text-end fw-bold">@totalAmount.ToString("N0") VNĐ</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
