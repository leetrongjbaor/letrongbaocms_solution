@* KHÔNG hiển thị Password *@
@model IEnumerable<CMS.Data.Entities.Customer>
@{
    ViewData["Title"] = "Danh Sách Khách Hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-warning fw-bold">👥 DANH SÁCH KHÁCH HÀNG</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary fs-6">Tổng: @Model.Count() khách hàng</span>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm khách hàng
            </a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-warning">
            <tr>
                <th>ID</th>
                <th>Họ và Tên</th>
                <th>Email</th>
                <th>Điện Thoại</th>
                <th>Địa Chỉ</th>
                <th style="width:160px" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Xóa khách hàng @item.FullName?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>