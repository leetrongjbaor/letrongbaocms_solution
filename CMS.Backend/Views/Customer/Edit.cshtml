@* KHÔNG hiển thị Password ra ngoài — chỉ cho sửa nội bộ *@
@model CMS.Data.Entities.Customer
@{
    ViewData["Title"] = "Sửa Khách Hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="text-warning fw-bold mb-4">✏️ CHỈNH SỬA KHÁCH HÀNG</h2>
            <hr />
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />  @* QUAN TRỌNG — không xóa *@

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và tên:</label>
                    <input asp-for="FullName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email:</label>
                    <input asp-for="Email" class="form-control" type="email" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Điện thoại:</label>
                    <input asp-for="Phone" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ:</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mật khẩu:</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <div class="form-text text-muted">
                        Để trống nếu không muốn đổi mật khẩu
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        💾 Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </div>
</div>