@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Sửa Sản Phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="text-warning fw-bold mb-4">✏️ CHỈNH SỬA SẢN PHẨM</h2>
            <hr />
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />  @* QUAN TRỌNG — không xóa *@

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm:</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Danh mục:</label>
                    <select asp-for="CategoryProductId" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Id"
                                    selected="@(cat.Id == Model.CategoryProductId ? "selected" : null)">
                                @cat.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giá (VNĐ):</label>
                        <input asp-for="Price" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tồn kho:</label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        💾 Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </div>
</div>