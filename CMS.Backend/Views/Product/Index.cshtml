@model IEnumerable<CMS.Data.Entities.Product>
@{
    ViewData["Title"] = "Danh Sách Sản Phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success fw-bold">🛒 DANH SÁCH SẢN PHẨM</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary fs-6">Tổng: @Model.Count() sản phẩm</span>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Tên Sản Phẩm</th>
                <th>Danh Mục</th>
                <th class="text-end">Giá (VNĐ)</th>
                <th class="text-center">Tồn Kho</th>
                <th>Mô Tả</th>
                <th style="width:160px" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            @(item.CategoryProduct?.Name ?? "N/A")
                        </span>
                    </td>
                    <td class="text-end">@item.Price.ToString("N0")</td>
                    <td class="text-center">
                        @if (item.StockQuantity > 10)
                        {
                            <span class="badge bg-success">@item.StockQuantity</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.StockQuantity</span>
                        }
                    </td>
                    <td>@item.Description</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Xóa sản phẩm này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>