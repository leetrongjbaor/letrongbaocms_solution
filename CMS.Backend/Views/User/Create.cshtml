@model CMS.Data.Entities.User
@{
    ViewData["Title"] = "Thêm Thành Viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="text-success fw-bold mb-4">➕ THÊM THÀNH VIÊN MỚI</h2>
            <hr />
            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên đăng nhập:</label>
                    <input asp-for="Username" class="form-control"
                           placeholder="Nhập tên đăng nhập..." />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và tên:</label>
                    <input asp-for="FullName" class="form-control"
                           placeholder="Nhập họ và tên..." />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu:</label>
                    <input asp-for="PasswordHash" class="form-control"
                           type="password" placeholder="Nhập mật khẩu..." />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Quyền hạn:</label>
                    <select asp-for="Role" class="form-select">
                        <option value="">-- Chọn quyền --</option>
                        <option value="Admin">Admin</option>
                        <option value="Editor">Editor</option>
                        <option value="Moderator">Moderator</option>
                        <option value="Member">Member</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        💾 Lưu thành viên
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </div>
</div>