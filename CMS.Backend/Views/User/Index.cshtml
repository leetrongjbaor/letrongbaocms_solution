@* Lưu ý: KHÔNG hiển thị PasswordHash theo yêu cầu bài tập *@
@model IEnumerable<CMS.Data.Entities.User>
@{
    ViewData["Title"] = "Quản Lý Thành Viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">👤 QUẢN LÝ THÀNH VIÊN</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary fs-6">Tổng: @Model.Count() thành viên</span>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm thành viên mới
            </a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Tên Đăng Nhập</th>
                <th>Họ Và Tên</th>
                <th>Quyền Hạn</th>
                <th style="width:160px" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Username</td>
                    <td>@item.FullName</td>
                    <td>
                        @{
                            var roleBadge = item.Role switch
                            {
                                "Admin" => "bg-danger",
                                "Editor" => "bg-primary",
                                "Moderator" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @roleBadge">@item.Role</span>
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Xóa thành viên @item.Username?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>