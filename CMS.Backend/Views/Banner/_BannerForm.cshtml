@model CMS.Data.Entities.Banner

<div class="mb-3">
    <label asp-for="Title" class="form-label">Tiêu đề</label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Subtitle" class="form-label">Mô tả ngắn</label>
    <input asp-for="Subtitle" class="form-control" />
</div>

<div class="mb-3">
    <label class="form-label">Chọn ảnh từ máy</label>
    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
    <div class="form-text">Có thể chọn file ảnh hoặc nhập link ảnh bên dưới.</div>
</div>

<div class="mb-3">
    <label asp-for="ImageUrl" class="form-label">Link ảnh</label>
    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
    <span asp-validation-for="ImageUrl" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="LinkUrl" class="form-label">Link khi bấm banner</label>
    <input asp-for="LinkUrl" class="form-control" placeholder="/shop hoặc https://..." />
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Position" class="form-label">Vị trí</label>
        <input asp-for="Position" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DisplayOrder" class="form-label">Thứ tự</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
    </div>
</div>

<div class="form-check">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Hiển thị banner</label>
</div>
