@model IEnumerable<CMS.Data.Entities.Banner>
@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Quản lý Banner</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Thêm banner
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle bg-white">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Ảnh</th>
                <th>Tiêu đề</th>
                <th>Vị trí</th>
                <th>Thứ tự</th>
                <th>Trạng thái</th>
                <th style="width:150px" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        <img src="@item.ImageUrl" alt="@item.Title" style="width:120px;height:56px;object-fit:cover" class="rounded border" />
                    </td>
                    <td>
                        <strong>@item.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                        {
                            <div class="text-muted small">@item.Subtitle</div>
                        }
                    </td>
                    <td>@item.Position</td>
                    <td>@item.DisplayOrder</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Đang bật</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Đang tắt</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa banner này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
