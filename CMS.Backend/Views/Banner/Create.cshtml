@model CMS.Data.Entities.Banner
@{
    ViewData["Title"] = "Thêm Banner";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-3">Thêm Banner</h2>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
        @Html.AntiForgeryToken()
        <partial name="_BannerForm" model="Model" />
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>
